# ── LLM Provider 选择（deepseek / openai / dashscope / zhipu）──
LLM_PROVIDER=deepseek

# ── 各 Provider 的 API Key（按需填写当前启用 provider 的）──
DEEPSEEK_API_KEY=your-deepseek-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here
ZHIPU_API_KEY=your-zhipu-api-key-here

# ── 可选覆盖模型名 / 参数 ──
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096
# MOCK_LLM=1

# ── Embedding ──
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING_DEVICE=cpu

# ── Web 服务 ──
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# Crawler tuning
# CRAWLER_MAX_PAGES=3
# CRAWLER_TIMEOUT=30
# CRAWLER_REQUEST_INTERVAL=3
# CRAWLER_EXTRA_KEYWORDS=机器学习,数据工程
# CRAWLER_EXTRA_PLATFORMS=custom_platform
# LIEPIN_BROWSER_ENABLED=1
# LIEPIN_BROWSER_MAX_PAGES=5
# LIEPIN_BROWSER_RENDER_WAIT_SECONDS=2
# LIEPIN_BROWSER_MIN_CARDS_PER_PAGE=5
# COOKIE_LAGOU=
# COOKIE_LIEPIN=
# COOKIE_ZHILIAN=
# COOKIE_JOBUI=
# COOKIE_51JOB=
