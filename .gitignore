# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-codex312/
.venv_v1/
venv/

# ── 测试 / 工具缓存 ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── 编辑器 ──
.vscode/
.idea/
*.swp
*~
*.orig

# ── 运行产物 / 日志 ──
*.log
web_out.log
web_err.log
web_run.log
.env
.env.*
!.env.example

# ── 数据目录(保留 .gitkeep)──
**/data/chroma_db/*
**/data/chroma_db_backup_*/
**/data/crawled_jobs/*
**/data/raw/*
!**/data/**/.gitkeep

# ── 打包产物目录(保留源码)──
**/desktop/build/
**/desktop/dist/
*.spec.bak
build/
dist/
*.whl
*.tar.gz

# ── 输出产物目录(保留 .gitkeep)──
**/output/*
!**/output/**/.gitkeep

# ── 操作系统 / Jupyter 杂项 ──
Thumbs.db
Desktop.ini
.DS_Store
.ipynb_checkpoints/

# ── 本地模型（Rerank 权重约 2.2GB，不入库；下载方式见根 README）──
models/

# ── 本地验证产物 ──
web_verify.*
