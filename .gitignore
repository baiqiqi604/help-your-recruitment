# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-codex312/
.venv_v1/
venv/

# ── 编辑器 ──
.vscode/
.idea/

# ── 运行产物 / 日志 ──
*.log
web_out.log
web_err.log
web_run.log
.env

# ── 数据目录(保留 .gitkeep)──
**/data/chroma_db/*
**/data/chroma_db_backup_*/
**/data/crawled_jobs/*
**/data/raw/*
!**/data/**/.gitkeep

# ── 打包产物目录(保留源码)──
**/desktop/build/
**/desktop/dist/
*.spec.bak

# ── 输出产物目录(保留 .gitkeep)──
**/output/*
!**/output/**/.gitkeep
